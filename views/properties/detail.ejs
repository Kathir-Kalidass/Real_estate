<%- include('../partials/navbar') %>

<%- include('../partials/flash-messages') %>

<div class="container mt-4">
    <div class="row">
        <!-- Property Images -->
        <div class="col-lg-8">
            <% if (images && images.length > 0) { %>
                <div class="property-image-carousel mb-3">
                    <img id="main-property-image" src="<%= images[0].image_url %>" alt="<%= property.title %>" 
                         class="img-fluid rounded shadow-sm w-100" style="height: 400px; object-fit: cover;">
                </div>
                
                <% if (images.length > 1) { %>
                    <div class="property-image-thumbnails d-flex gap-2 overflow-auto">
                        <% images.forEach((image, index) => { %>
                            <img src="<%= image.image_url %>" alt="<%= property.title %>" 
                                 class="img-thumbnail <%= index === 0 ? 'active' : '' %>" 
                                 style="width: 100px; height: 80px; object-fit: cover; cursor: pointer;">
                        <% }); %>
                    </div>
                <% } %>
            <% } else { %>
                <div class="bg-light d-flex align-items-center justify-content-center rounded" 
                     style="height: 400px;">
                    <i class="bi bi-house text-muted" style="font-size: 4rem;"></i>
                </div>
            <% } %>
        </div>
        
        <!-- Property Details -->
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h1 class="h3 mb-3"><%= property.title %></h1>
                    
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="h4 text-primary mb-0">$<%= property.price.toLocaleString() %></span>
                        <span class="badge bg-secondary fs-6">
                            <%= property.property_type.charAt(0).toUpperCase() + property.property_type.slice(1) %>
                        </span>
                    </div>
                    
                    <p class="text-muted mb-3">
                        <i class="bi bi-geo-alt"></i> <%= property.location %>
                    </p>
                    
                    <% if (property.bedrooms || property.bathrooms || property.area_sqft) { %>
                        <div class="row mb-3">
                            <% if (property.bedrooms) { %>
                                <div class="col-4 text-center">
                                    <i class="bi bi-door-closed text-primary"></i>
                                    <div class="small"><%= property.bedrooms %> Bed</div>
                                </div>
                            <% } %>
                            <% if (property.bathrooms) { %>
                                <div class="col-4 text-center">
                                    <i class="bi bi-water text-primary"></i>
                                    <div class="small"><%= property.bathrooms %> Bath</div>
                                </div>
                            <% } %>
                            <% if (property.area_sqft) { %>
                                <div class="col-4 text-center">
                                    <i class="bi bi-arrows-angle-expand text-primary"></i>
                                    <div class="small"><%= property.area_sqft %> sq ft</div>
                                </div>
                            <% } %>
                        </div>
                    <% } %>
                    
                    <hr>
                    
                    <h5>Owner Information</h5>
                    <p class="mb-2"><strong><%= property.owner_full_name || property.owner_name %></strong></p>
                    <% if (property.owner_phone) { %>
                        <p class="text-muted mb-3">
                            <i class="bi bi-telephone"></i> <%= property.owner_phone %>
                        </p>
                    <% } %>
                    
                    <% if (user) { %>
                        <% if (user.role === 'buyer' && user.id !== property.owner_id) { %>
                            <a href="/chat/property/<%= property.id %>" class="btn btn-primary w-100 mb-2">
                                <i class="bi bi-chat-dots"></i> Chat with Owner
                            </a>
                        <% } else if (user.id === property.owner_id) { %>
                            <div class="d-grid gap-2">
                                <a href="/properties/edit/<%= property.id %>" class="btn btn-outline-primary">
                                    <i class="bi bi-pencil"></i> Edit Property
                                </a>
                                <form action="/properties/<%= property.id %>?_method=DELETE" method="POST" 
                                      onsubmit="return confirm('Are you sure you want to delete this property?')">
                                    <button type="submit" class="btn btn-outline-danger w-100">
                                        <i class="bi bi-trash"></i> Delete Property
                                    </button>
                                </form>
                            </div>
                        <% } %>
                    <% } else { %>
                        <p class="text-center text-muted">
                            <a href="/auth/login">Login</a> to contact the owner
                        </p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Property Description -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h5>Description</h5>
                    <p><%= property.description %></p>
                    
                    <hr>
                    
                    <div class="row text-muted small">
                        <div class="col-md-6">
                            <strong>Listed:</strong> <%= new Date(property.created_at).toLocaleDateString() %>
                        </div>
                        <% if (property.updated_at !== property.created_at) { %>
                            <div class="col-md-6">
                                <strong>Updated:</strong> <%= new Date(property.updated_at).toLocaleDateString() %>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
