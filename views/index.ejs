<%- include('partials/navbar') %>

<%- include('partials/flash-messages') %>

<!-- Hero Section -->
<section class="hero-section bg-primary text-white py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold mb-4">Find Your Dream Home</h1>
                <p class="lead mb-4">Discover amazing properties from trusted sellers. Whether you're buying or selling, we've got you covered.</p>
                <% if (!user) { %>
                    <div class="d-flex gap-3">
                        <a href="/auth/register" class="btn btn-light btn-lg">Get Started</a>
                        <a href="/properties" class="btn btn-outline-light btn-lg">Browse Properties</a>
                    </div>
                <% } else { %>
                    <a href="/properties" class="btn btn-light btn-lg">Browse Properties</a>
                <% } %>
            </div>
            <div class="col-lg-6">
                <img src="https://images.unsplash.com/photo-1560518883-ce09059eeffa?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80" 
                     alt="Modern House" class="img-fluid rounded shadow">
            </div>
        </div>
    </div>
</section>

<!-- Search Section -->
<section class="search-section py-4 bg-light">
    <div class="container">
        <form action="/properties" method="GET" class="row g-3">
            <div class="col-md-3">
                <input type="text" class="form-control" name="search" placeholder="Search properties..." 
                       value="<%= typeof searchParams !== 'undefined' ? searchParams.search || '' : '' %>">
            </div>
            <div class="col-md-3">
                <input type="text" class="form-control" name="location" placeholder="Location" 
                       value="<%= typeof searchParams !== 'undefined' ? searchParams.location || '' : '' %>">
            </div>
            <div class="col-md-2">
                <input type="number" class="form-control" name="minPrice" placeholder="Min Price" 
                       value="<%= typeof searchParams !== 'undefined' ? searchParams.minPrice || '' : '' %>">
            </div>
            <div class="col-md-2">
                <input type="number" class="form-control" name="maxPrice" placeholder="Max Price" 
                       value="<%= typeof searchParams !== 'undefined' ? searchParams.maxPrice || '' : '' %>">
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i> Search
                </button>
            </div>
        </form>
    </div>
</section>

<!-- Featured Properties -->
<section class="properties-section py-5">
    <div class="container">
        <div class="row mb-4">
            <div class="col-12">
                <h2 class="text-center mb-4">Featured Properties</h2>
                <% if (properties && properties.length > 0) { %>
                    <div class="row">
                        <% properties.forEach(property => { %>
                            <div class="col-lg-4 col-md-6 mb-4">
                                <%- include('partials/property-card', { property: property }) %>
                            </div>
                        <% }); %>
                    </div>
                    <div class="text-center mt-4">
                        <a href="/properties" class="btn btn-primary btn-lg">View All Properties</a>
                    </div>
                <% } else { %>
                    <div class="text-center">
                        <h4 class="text-muted">No properties available yet</h4>
                        <p class="text-muted">Be the first to list a property!</p>
                        <% if (user && user.role === 'owner') { %>
                            <a href="/properties/add" class="btn btn-primary">Add Property</a>
                        <% } %>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="features-section py-5 bg-light">
    <div class="container">
        <div class="row text-center">
            <div class="col-12 mb-5">
                <h2>Why Choose Our Platform?</h2>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-shield-check text-primary" style="font-size: 3rem;"></i>
                        <h5 class="card-title mt-3">Secure & Safe</h5>
                        <p class="card-text">All transactions are secure with verified property owners and buyers.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-chat-dots text-primary" style="font-size: 3rem;"></i>
                        <h5 class="card-title mt-3">Direct Communication</h5>
                        <p class="card-text">Chat directly with property owners in real-time to get answers fast.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center">
                        <i class="bi bi-search text-primary" style="font-size: 3rem;"></i>
                        <h5 class="card-title mt-3">Easy Search</h5>
                        <p class="card-text">Find properties quickly with our advanced search and filter options.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
